# חיבור למסד נתונים Postgres (Neon/Supabase בפרודקשן, מקומי בפיתוח)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hadran
# מפתח סודי של Payload — צרו מחרוזת אקראית ארוכה
PAYLOAD_SECRET=YOUR_SECRET_HERE
# כתובת האתר המלאה (ל-SEO, sitemap, JSON-LD)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
